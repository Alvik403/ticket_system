NODE_ENV=development
PORT=3000
DB_SYNCHRONIZE=true
COOKIE_SECURE=false
ENABLE_OPENAPI=true
ALLOW_LOCALHOST_CORS=true
CLIENT_ORIGIN=http://localhost:5173
STAFF_ORIGIN=http://localhost:5174
DATABASE_URL=postgresql://ticket:ticket@localhost:55432/ticket
REDIS_URL=redis://localhost:56379
SESSION_SECRET=replace-with-at-least-32-random-characters
OIDC_ISSUER=http://localhost:18081/realms/ticket-system
OIDC_CLIENT_ID=ticket-staff
OIDC_CLIENT_SECRET=replace-in-production
OIDC_CALLBACK_URL=http://localhost:3000/api/auth/callback
STAFF_APP_URL=http://localhost:5174
KEYCLOAK_ADMIN_URL=http://localhost:18081
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
RETENTION_TICKET_DAYS=90
RETENTION_AUDIT_DAYS=365

# Docker on any host: login, cookies and CORS follow the browser Host header.
# For HTTPS set COOKIE_SECURE=true. Optional extra origins: CLIENT_ORIGIN, STAFF_ORIGIN, PUBLIC_ORIGIN.

POSTGRES_PASSWORD=replace-db-password
REDIS_PASSWORD=replace-redis-password

# Production compose: sudo bash infra/prod-up.sh from repo root.
# Required: POSTGRES_PASSWORD, REDIS_PASSWORD, SESSION_SECRET,
# OIDC_CLIENT_SECRET, KC_BOOTSTRAP_ADMIN_PASSWORD.
# Enable TOTP for ADMIN in Keycloak.
