NODE_ENV=development
PORT=3000
DB_SYNCHRONIZE=true
COOKIE_SECURE=false
ENABLE_OPENAPI=true
ALLOW_LOCALHOST_CORS=true
CLIENT_ORIGIN=http://localhost:5173
STAFF_ORIGIN=http://localhost:5174
DATABASE_URL=postgresql://ticket:ticket@localhost:55432/ticket
REDIS_URL=redis://localhost:56379
SESSION_SECRET=replace-with-at-least-32-random-characters
OIDC_ISSUER=http://localhost:58080/realms/ticket-system
OIDC_CLIENT_ID=ticket-staff
OIDC_CLIENT_SECRET=replace-in-production
OIDC_CALLBACK_URL=http://localhost:3000/api/auth/callback
STAFF_APP_URL=http://localhost:5174
RETENTION_TICKET_DAYS=90
RETENTION_AUDIT_DAYS=365

# Production compose (infra/docker-compose.prod.yml) requires:
# POSTGRES_PASSWORD, REDIS_PASSWORD, SESSION_SECRET, OIDC_CLIENT_SECRET,
# KC_BOOTSTRAP_ADMIN_PASSWORD, CLIENT_ORIGIN, STAFF_ORIGIN, OIDC_ISSUER,
# OIDC_CALLBACK_URL, STAFF_APP_URL, KC_HOSTNAME. Enable TOTP for ADMIN in Keycloak.

