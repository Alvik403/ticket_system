FROM node:24-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/client-web/package.json ./apps/client-web/package.json
COPY apps/staff-web/package.json ./apps/staff-web/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
RUN npm ci

COPY apps/client-web ./apps/client-web
COPY apps/staff-web ./apps/staff-web

ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_BASE=/client/
RUN npm run build --workspace client-web
ENV VITE_BASE=/staff/
RUN npm run build --workspace staff-web

FROM nginx:1.29-alpine AS runtime

ARG NGINX_CONF=infra/nginx.conf
COPY ${NGINX_CONF} /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/client-web/dist /usr/share/nginx/html/client
COPY --from=build /app/apps/staff-web/dist /usr/share/nginx/html/staff

EXPOSE 8080 18080
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/client/ || exit 1

